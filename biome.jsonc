{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		// WHY a list of what is covered, not "everything except spikes": spikes/ holds throwaway
		// code that reproduces one experiment with pinned library versions and is not kept to the
		// standard of packages/. Listing packages/ also keeps Biome out of target/ and fixtures/.
		// WHY interop/ file by file: "interop/**" would take in generated output (.dist/, .cert/)
		// and interop/peers/. The peers are copies of code written for moqtail, kept as they
		// came so that a diff against their source stays readable; reformatting or relinting
		// them would bury that diff.
		"includes": [
			"package.json",
			"packages/**",
			"interop/*.ts",
			"interop/*.json",
			"interop/*.html"
		]
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": {
				// WHY: `x!` is a type assertion in another spelling; the `as` ban in
				// .oxlintrc.jsonc would otherwise be sidestepped with it.
				"noNonNullAssertion": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/spikes/**"],
								"message": "spikes/ is throwaway validation code; packages must not depend on it."
							},
							{
								"group": ["**/interop/**", "@xmoq/interop", "@xmoq/interop/**"],
								"message": "interop/ checks the packages against other implementations; a package must not depend on it."
							}
						]
					}
				}
			}
		}
	},
	"overrides": [
		{
			// WHY: the catalog is JSON and bytes. The part of @xmoq/msf that reads and
			// checks it must not know a connection, nor the transport package at all;
			// tsconfig.core.json keeps the I/O globals out, and this the imports.
			// An override replaces the options of the rule, so the two patterns above are
			// repeated here.
			"includes": ["packages/msf/src/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/spikes/**"],
										"message": "spikes/ is throwaway validation code; packages must not depend on it."
									},
									{
										"group": [
											"**/interop/**",
											"@xmoq/interop",
											"@xmoq/interop/**"
										],
										"message": "interop/ checks the packages against other implementations; a package must not depend on it."
									},
									{
										"group": ["@xmoq/moqt", "@xmoq/moqt/**", "**/moqt/**"],
										"message": "src/core of @xmoq/msf reads and writes catalogs without MoQ Transport; what uses a connection belongs outside src/core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// WHY: scripts/ci/check-layers.sh sees a dependency that package.json declares.
			// A file of @xmoq/moqt could still reach the other package by a relative path,
			// which declares nothing.
			// An override replaces the options of the rule, so the two patterns above are
			// repeated here; the override for src/core below repeats this one in turn.
			"includes": ["packages/moqt/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/spikes/**"],
										"message": "spikes/ is throwaway validation code; packages must not depend on it."
									},
									{
										"group": [
											"**/interop/**",
											"@xmoq/interop",
											"@xmoq/interop/**"
										],
										"message": "interop/ checks the packages against other implementations; a package must not depend on it."
									},
									{
										"group": ["@xmoq/msf", "@xmoq/msf/**", "**/msf/**"],
										"message": "MoQ Transport is the layer below the streaming format: @xmoq/msf may use @xmoq/moqt, not the other way round."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// WHY: tsconfig.core.json stops src/core from using I/O globals, but a file of
			// src/webtransport that uses none of them could still be imported and would
			// compile. The codec and the session must not know the connection at all.
			// An override replaces the options of the rule, so the two patterns above are
			// repeated here.
			"includes": ["packages/moqt/src/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/spikes/**"],
										"message": "spikes/ is throwaway validation code; packages must not depend on it."
									},
									{
										"group": [
											"**/interop/**",
											"@xmoq/interop",
											"@xmoq/interop/**"
										],
										"message": "interop/ checks the packages against other implementations; a package must not depend on it."
									},
									{
										"group": ["**/webtransport/**"],
										"message": "src/core has no I/O; src/webtransport depends on it, not the other way round."
									},
									{
										"group": ["@xmoq/msf", "@xmoq/msf/**", "**/msf/**"],
										"message": "MoQ Transport is the layer below the streaming format: @xmoq/msf may use @xmoq/moqt, not the other way round."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
