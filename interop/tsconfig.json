{
	// The driver, which runs on Bun. The pages run in a browser and are checked
	// by tsconfig.page.json, so that neither side can use the other's globals.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"types": ["bun"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	// WHY a pattern and not the names: a driver that was added and not named
	// here was not type-checked at all, and nothing said so (fetch.ts and
	// fetch-rust.ts, with five errors between them). peers/ is not matched:
	// the pattern has no directory in it.
	"include": ["*.ts"],
	// The page runs in a browser; tsconfig.page.json checks it.
	"exclude": ["page.ts"]
}
